{
  // ==== RELAY CLIENT (داخل ایران) — REALITY با مسیر پشتیبان CDN ====
  // کاربران OpenVPN به این باکس روی 2083 وصل می‌شوند؛ این باکس همه را از داخل
  // تونل به exit می‌رساند. روی خط ایران→خارج فقط HTTPS به SNI مایکروسافت دیده می‌شود.

  // مسیر اصلی: IP خام سرور exit، چند پورت. هر اتصال یکی را تصادفی برمی‌دارد و
  // اگر یکی جواب ندهد خودکار سراغ بعدی می‌رود (بدون دخالت شما).
  "servers": [
    "91.107.159.20:443",
    "91.107.159.20:8880",
    "91.107.159.20:2053"
  ],
  // اگر exit دوم هم دارید (با همان رمز و کلید) این‌جا اضافه کنید تا ترافیک بین
  // چند IP پخش شود و هیچ IPای حجم مشکوکی نگیرد:
  // "servers": ["91.107.159.20:443", "1.2.3.4:443"],

  "password": "CHANGE_ME_openssl_rand_hex_24",

  // باید یکی از server_names سرور باشد.
  "sni": "www.microsoft.com",
  // firefox/safari تک‌پکتی هستند؛ chrome (ML-KEM) دو پکت می‌شود و DPI ایران آن را drop می‌کند.
  "fingerprint": "firefox",

  "reality": {
    // کلید عمومی از خروجی  tunnel-server -keygen
    "public_key": "PASTE_PUBLIC_KEY",
    "short_id": "a1b2c3d4"
  },

  // ==== مسیر پشتیبان: از راه کلودفلر ====
  // فقط وقتی استفاده می‌شود که مسیر اصلی کار نکند؛ به محض این‌که مسیر اصلی
  // برگردد، خودکار به آن برمی‌گردد. کاربر هیچ‌کدام را نمی‌فهمد.
  // اگر دامنه/کلودفلر ندارید، کل این بخش را حذف کنید.
  "backups": [
    {
      // دامنه‌ی خودتان که در کلودفلر پروکسی (ابر نارنجی) است و به IP این exit
      // اشاره می‌کند. اتصال در واقع به IP های کلودفلر می‌رود.
      "server": "cdn.example.com:8443",
      "sni": "cdn.example.com",
      // همان path که در ws.path سرور گذاشتید.
      "ws": { "path": "/live/stream/5f3c1a9e" }
    }
  ],

  "socks_listen": "", "http_listen": "",
  "forwards": [
    { "listen": "0.0.0.0:2083", "target": "127.0.0.1:2083" }
  ],

  // pool = چند اتصال TCP هم‌زمان، concurrency = چند کاربر روی هر اتصال.
  // کاربرها اول روی اتصال‌های جدید پخش می‌شوند و بعد روی‌هم انباشته می‌شوند،
  // چون روی مسیر بین‌الملل سرعتِ کل با تعداد جریان‌ها بالا می‌رود و افت یک
  // جریان فقط کاربرهای همان اتصال را می‌گیرد. ۳۲×۳۲ = ۱۰۲۴ کاربر هم‌زمان.
  //
  // rotate_*: هر اتصال TLS حداکثر این عمر/حجم را دارد (تصادفی بین نصف تا کامل)
  // و بعد با اتصال تازه عوض می‌شود، بدون این‌که کاربر چیزی بفهمد. همین جلوی
  // «بعد از یک ساعت ۱-۲ مگابیت می‌شود» را می‌گیرد.
  "mux": { "enabled": true, "concurrency": 32, "pool": 32, "rotate_seconds": 240, "rotate_mb": 192 },

  "log": "info"
}
