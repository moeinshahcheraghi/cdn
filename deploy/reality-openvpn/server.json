{
  // ==== EXIT SERVER (خارج از ایران) — REALITY + درِ پشتی CDN ====
  // نیازی به دامنه، گواهی یا وب‌سایت نیست. سرور خودش را جای www.microsoft.com
  // جا می‌زند: هر کسی که کلید نداشته باشد (پروب فیلترینگ) عیناً به سایت واقعی
  // مایکروسافت وصل می‌شود و گواهی اصلی آن را می‌بیند.
  //
  // چند پورت با کاما: اگر فیلترینگ ۴۴۳ را روی این IP ببندد، کلاینت روی ۸۸۰
  // یا ۲۰۵۳ ادامه می‌دهد بدون این‌که چیزی را دوباره نصب کنید.
  "listen": ":443,:8880,:2053",

  // رمز مشترک؛ بایت‌به‌بایت با "password" کلاینت یکی باشد.
  "passwords": ["CHANGE_ME_openssl_rand_hex_24"],

  "reality": {
    // سایت واقعی که تقلید می‌شود. باید TLS 1.3 داشته باشد و از ایران باز باشد.
    // گزینه‌های رایج: www.microsoft.com:443 ، dl.google.com:443 ، www.speedtest.net:443
    "dest": "www.microsoft.com:443",
    // SNI هایی که پذیرفته می‌شوند؛ کلاینت باید همین را در "sni" بگذارد.
    "server_names": ["www.microsoft.com"],
    // خروجی  tunnel-server -keygen  (کلید خصوصی این‌جا، کلید عمومی در کلاینت)
    "private_key": "PASTE_PRIVATE_KEY",
    // برچسب کلاینت‌ها؛ هر مقدار hex تا ۱۶ کاراکتر. کلاینت یکی از این‌ها را می‌فرستد.
    "short_ids": ["a1b2c3d4"],
    // اختلاف ساعت مجاز (ثانیه). کلاینت حالا خودش ساعت را تصحیح می‌کند، ولی
    // روی هر دو سرور  timedatectl set-ntp true  را هم بزنید.
    "max_time_diff": 120
  },

  // ==== درِ دوم: WebSocket برای عبور از CDN (کلودفلر) ====
  // وقتی IP این سرور از یک دیتاسنتر اصلاً باز نمی‌شود، کلاینت از مسیر کلودفلر
  // می‌آید: به IP های کلودفلر وصل می‌شود، کلودفلر به این پورت فوروارد می‌کند.
  // این پورت TLS با گواهی معمولی می‌دهد (نه REALITY)، چون کلودفلر باید آن را
  // بفهمد. خالی گذاشتن tls_cert یعنی گواهی self-signed، که با SSL mode
  // «Full» (نه Full strict) در کلودفلر کار می‌کند.
  "ws": {
    // مسیر مخفی؛ حکم رمز دوم را دارد. عوضش کنید. هر مسیر دیگری روی این پورت
    // همان سایت fallback را می‌بیند، پس اسکن مسیرها چیزی پیدا نمی‌کند.
    "path": "/live/stream/5f3c1a9e",
    // ۸۴۴۳ یکی از پورت‌هایی است که کلودفلر برای origin قبول می‌کند.
    "listen": ":8443"
  },
  // اگر Origin Certificate کلودفلر را گرفتید (بهتر، با Full strict):
  // "tls_cert": "/etc/tunnel/cf-origin.pem",
  // "tls_key":  "/etc/tunnel/cf-origin.key",

  // سایتی که به هر کسی که رمز/مسیر درست ندارد نشان داده می‌شود.
  "fallback": "www.wikipedia.org:443",

  "log": "info"
}
