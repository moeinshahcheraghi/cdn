[Unit]
Description=DPI-resistant tunnel server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Binds :443; allow that without full root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=/usr/local/bin/tunnel-server -c /etc/tunnel/server.json
Restart=always
RestartSec=2
LimitNOFILE=1048576
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
