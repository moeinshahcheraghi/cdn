{
  // host:port of your server.
  "server": "your-domain.example:443",
  // Several addresses may be given instead: each connection picks one at
  // random and a failing one is set aside and retried in the background, so
  // more than one exit IP (or port) carries the traffic.
  // "servers": ["1.2.3.4:443", "1.2.3.4:8880", "5.6.7.8:443"],
  "password": "change-me-to-a-long-random-secret",
  // SNI to present; must match the server certificate's domain.
  "sni": "your-domain.example",
  // Browser TLS fingerprint to mimic: chrome|firefox|safari|ios|edge|random.
  // Prefer firefox or safari. Modern Chrome's ClientHello carries a post-quantum
  // (ML-KEM) key share (~1.7 KB) that spans two TCP packets; some censors (e.g.
  // Iran) drop the split ClientHello, causing handshake timeouts. firefox/safari
  // fit in one packet.
  "fingerprint": "firefox",
  // Experimental Linux Ethernet/IPv4 raw injection; requires CAP_NET_RAW.
  // This fake name is separate from the real sni/HTTP host above. It does
  // not guarantee access through a whitelist. Omit to disable.
  // "fake_sni": "chatgpt.com",
  // Split the ClientHello into small pieces so DPI cannot read the SNI from
  // one packet. For a network that filters by domain: e.g. from some Iranian
  // datacenters several .ir domains behind Cloudflare were reset or had their
  // upload cut after 64 KB. mode "records" (default) also splits TLS records; "tcp" only the
  // segments. Costs ~100-200 ms per new connection. Backups inherit it.
  // "fragment": { "enabled": true, "mode": "records", "size": "30-80", "delay": "5-15" },
  // REALITY, when public_key is set: the server borrows a big site's identity
  // and "server" may be a bare IP. "sni" must then be one of its server_names.
  // "reality": { "public_key": "FROM_SERVER_KEYGEN", "short_id": "a1b2c3d4" },
  //
  // Carry the tunnel in plain HTTP/2 requests, which is how it passes through
  // a CDN (Cloudflare): "server"/"sni" are then your CDN-proxied domain and
  // "path" must match the server's ws.path. "ws" in place of "http" uses a
  // WebSocket instead (the older carrier).
  // "http": { "path": "/live/stream/5f3c1a9e" },
  //
  // Hide the domain from the censor with ECH: it then sees only
  // cloudflare-ech.com. Value: the ech= part of `dig +short HTTPS your.domain`.
  // "ech": "AEX+DQBB...AAA=",
  //
  // Alternative routes, used only while the route above is failing, and
  // dropped again the moment it recovers. A CDN backup survives the exit IP
  // being blocked outright.
  // "backups": [
  //   { "server": "cdn.example.com:8443", "sni": "cdn.example.com",
  //     "http": { "path": "/live/stream/5f3c1a9e" } }
  // ],
  //
  // Local proxies. Point your browser/system at either.
  "socks_listen": "127.0.0.1:1080",
  "http_listen": "127.0.0.1:1081",
  // Raw TCP port forwards through the tunnel. Anything connecting to "listen"
  // is delivered to "target" as seen from the server. Example: run this client
  // on an Iranian relay VPS and forward OpenVPN (TCP mode) to the exit server:
  //   "forwards": [{ "listen": "0.0.0.0:2083", "target": "127.0.0.1:1194" }]
  "forwards": [],
  // Multiplex many streams over few TLS connections for low latency.
  // "pool" connections are opened before streams are stacked up, since on a
  // policed international path throughput follows the number of flows and one
  // flow's loss then stalls only the users sharing it. rotate_seconds and
  // rotate_mb retire each connection after at most that age or traffic (a
  // random 50-100% of each) and move its streams to a fresh one, unnoticed.
  "mux": { "enabled": true, "concurrency": 8, "pool": 4,
           "rotate_seconds": 300, "rotate_mb": 256 },
  // Set true only with a self-signed server cert.
  "allow_insecure": false,
  "log": "info"
}
